# Copy to your hosting provider's environment settings (never commit real values).
DJANGO_DEBUG=false
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_ALLOWED_HOSTS=clinic.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://clinic.example.com
DATABASE_URL=postgres://user:password@host:5432/clinic

CLINIC_NAME_AR=مركز الأسنان والجلدية
CLINIC_NAME_EN=Dental & Derma Center
CLINIC_CURRENCY_AR=د.ل
CLINIC_CURRENCY_EN=LYD
CLINIC_TIME_ZONE=Africa/Tripoli
CLINIC_DAY_START=9
CLINIC_DAY_END=22

# First admin account, created on deploy if it doesn't exist (see build.sh)
DJANGO_ADMIN_USERNAME=owner
DJANGO_ADMIN_PASSWORD=choose-a-strong-password

# Password given to demo accounts by "python manage.py seed_demo" (local testing only)
SEED_PASSWORD=Clinic@2026
